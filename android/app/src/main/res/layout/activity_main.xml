<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/felix_bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- ============ HEADER ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_logo"
                android:contentDescription="@string/app_name">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_logo_mark"
                    android:contentDescription="@string/app_name"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Felix"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/felix_text_primary"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Voice calling assistant"
                    android:textSize="13sp"
                    android:textColor="@color/felix_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contactChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chip"
                android:paddingStart="11dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:minHeight="36dp">

                <View
                    android:id="@+id/contactDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_success" />

                <TextView
                    android:id="@+id/contactInfoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="Loading…"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/felix_text_secondary"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ VOICE CARD ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/felix_surface"
            app:cardCornerRadius="24dp"
            app:strokeColor="@color/felix_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="VOICE COMMAND"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:textColor="@color/felix_text_hint" />

                    <View
                        android:id="@+id/voiceStateDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_success" />

                    <TextView
                        android:id="@+id/voiceStateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Ready"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/felix_text_secondary" />
                </LinearLayout>

                <!-- Orb -->
                <FrameLayout
                    android:id="@+id/voiceOrbContainer"
                    android:layout_width="168dp"
                    android:layout_height="168dp"
                    android:layout_marginTop="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="Voice activation visual"
                    android:importantForAccessibility="no">

                    <View
                        android:id="@+id/voiceHaloOuter"
                        android:layout_width="168dp"
                        android:layout_height="168dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_halo" />

                    <View
                        android:id="@+id/voiceHaloInner"
                        android:layout_width="136dp"
                        android:layout_height="136dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_halo_inner"
                        android:alpha="0.6" />

                    <View
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_orb_ring" />

                    <LinearLayout
                        android:id="@+id/voiceOrbCore"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_orb_core">

                        <ImageView
                            android:id="@+id/voiceOrbIcon"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_mic"
                            android:contentDescription="Microphone"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Ready when you are."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/felix_text_primary"
                    android:lineSpacingMultiplier="1.3" />

                <TextView
                    android:id="@+id/voiceHintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Tap Activate Felix, then say “Call …”"
                    android:textSize="13sp"
                    android:textColor="@color/felix_text_secondary" />

                <TextView
                    android:id="@+id/heardText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_heard"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@color/felix_text_secondary"
                    android:visibility="gone"
                    android:lineSpacingMultiplier="1.3" />

                <LinearLayout
                    android:id="@+id/resultBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/activateButton"
                    style="@style/Widget.Felix.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="Activate Felix"
                    app:icon="@drawable/ic_mic_dark"
                    app:iconSize="20dp"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopButton"
                    style="@style/Widget.Felix.Button.DangerOutline"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="Stop listening"
                    app:icon="@drawable/ic_stop"
                    app:iconSize="16dp"
                    app:iconTint="@color/felix_error"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ HANDS-FREE CARD ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/felix_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/felix_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_logo">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_handsfree"
                            android:importantForAccessibility="no"
                            android:contentDescription="Hands-free" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hands-free mode"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/felix_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Wake-word listening"
                            android:textSize="12sp"
                            android:textColor="@color/felix_text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_warning"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="EXPERIMENTAL"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/felix_warning" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Say “Felix” to call without touching your phone. Everything stays on this device."
                    android:textSize="13sp"
                    android:textColor="@color/felix_text_secondary"
                    android:lineSpacingMultiplier="1.4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_info_box"
                    android:padding="12dp"
                    android:minHeight="48dp">

                    <View
                        android:id="@+id/handsFreeDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_muted" />

                    <TextView
                        android:id="@+id/handsFreeStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Hands-free mode is off."
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/felix_text_primary"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/handsFreeToggleButton"
                    style="@style/Widget.Felix.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Activate Hands-Free Mode"
                    app:icon="@drawable/ic_handsfree"
                    app:iconSize="20dp"
                    app:iconTint="@color/felix_accent" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/felix_border_soft" />

                <!-- Auto-call row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Automatic calling"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/felix_text_primary" />

                        <TextView
                            android:id="@+id/autoCallHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="13sp"
                            android:textColor="@color/felix_text_secondary"
                            android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/autoCallSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="56dp"
                        android:text=""
                        android:contentDescription="Automatic calling" />
                </LinearLayout>

                <!-- Sound-match row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Match names that sound alike"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/felix_text_primary" />

                        <TextView
                            android:id="@+id/soundMatchHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="13sp"
                            android:textColor="@color/felix_text_secondary"
                            android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/soundMatchSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="56dp"
                        android:text=""
                        android:contentDescription="Match names that sound alike" />
                </LinearLayout>

                <TextView
                    android:id="@+id/handsFreeSetupText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_info_box"
                    android:padding="12dp"
                    android:textSize="12sp"
                    android:textColor="@color/felix_text_secondary"
                    android:lineSpacingMultiplier="1.45" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/troubleshootButton"
                    style="@style/Widget.Felix.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Troubleshooting"
                    app:icon="@drawable/ic_troubleshoot"
                    app:iconSize="20dp"
                    app:iconTint="@color/felix_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ TYPED COMMAND CARD ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/felix_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/felix_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_logo">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_keyboard"
                            android:importantForAccessibility="no"
                            android:contentDescription="Type" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Type instead"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/felix_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="No microphone needed"
                            android:textSize="12sp"
                            android:textColor="@color/felix_text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:boxBackgroundColor="@color/felix_surface_sunken"
                        app:boxStrokeColor="@color/felix_border"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/typeCommandText"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@null"
                            android:hint="Type: Call Yash"
                            android:textColor="@color/felix_text_primary"
                            android:textColorHint="@color/felix_text_hint"
                            android:textSize="15sp"
                            android:inputType="text"
                            android:imeOptions="actionGo"
                            android:maxLength="120"
                            android:maxLines="1"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typeGoButton"
                        style="@style/Widget.Felix.Button"
                        android:layout_width="72dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:text="Go"
                        android:minWidth="0dp"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ FOOTER ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_info_box"
            android:padding="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shield"
                android:importantForAccessibility="no"
                android:contentDescription="Privacy" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Contacts stay on this device. Nothing is uploaded. The microphone runs only while Felix is listening."
                android:textSize="12sp"
                android:textColor="@color/felix_text_secondary"
                android:lineSpacingMultiplier="1.45" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
